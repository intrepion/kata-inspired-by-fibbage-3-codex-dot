{
  "name": "velvet-bluff",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "An original local multiplayer bluffing party game",
  "license": "MIT",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:browser": "playwright test",
    "format:check": "prettier --check src public test scripts playwright.config.js tsconfig.json package.json",
    "start": "node dist/server.js",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^25.0.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
